# ========================================
# ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ========================================
# Supabase Configuration (Required)
# ========================================
# Get these from: https://app.supabase.com/project/[your-project]/settings/api
# 1. Create a new project at https://supabase.com
# 2. Go to Project Settings → API
# 3. Copy the Project URL and anon/public key

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ========================================
# TMDB API Configuration (Required)
# ========================================
# Get these from: https://www.themoviedb.org/settings/api
# 1. Create an account at https://www.themoviedb.org
# 2. Go to Settings → API
# 3. Request an API key (choose "Developer" option)
# 4. Copy both the API Key and the Read Access Token

VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# ========================================
# Optional: Additional Configuration
# ========================================
# These are optional and have defaults in the code

# Application Port (default: 8080)
# PORT=8080

# Node Environment (development | production)
# NODE_ENV=development